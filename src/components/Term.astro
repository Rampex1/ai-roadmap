---
import { getEntry } from 'astro:content';

interface Props { id: string; text?: string; cap?: boolean }
const { id, text, cap } = Astro.props;
const entry = await getEntry('glossary', id);
if (!entry) throw new Error(`<Term id="${id}">: no glossary entry "${id}"`);
// Deterministic per-page id: count Term renders on this request.
const n = ((Astro.locals as any).__termCount = ((Astro.locals as any).__termCount ?? 0) + 1);
const tipId = `term-tip-${id}-${n}`;
// Glossary names are capitalised headings ("Entropy"); inline they read as normal words ("entropy").
// Keep proper nouns and words with inner capitals or acronyms (Bayes, Adam, DataFrame, NumPy, ReLU).
const PROPER = /^(Bayes|Adam|Jupyter|Gauss|Gaussian|Laplace|Markov|Python|Git|GitHub|Bernoulli|Poisson|Euclid|Euclidean|Fourier|Kullback|Shannon|Transformer)\b/;
// Judge the first word only (split on space or hyphen), so "Vector-Jacobian product" reads "vector-Jacobian product".
const inline = (s: string) => (PROPER.test(s) || /^\S*[A-Z]\S*[A-Z]|^[A-Z]{2}|^\S[A-Z]/.test(s.split(/[\s-]/)[0]) ? s : s.charAt(0).toLowerCase() + s.slice(1));
// `cap` keeps the capital for a term that starts a sentence, list item or heading.
const label = text ?? (cap ? entry.data.term : inline(entry.data.term));
---

<a class="air-term" data-term={id} href={`/glossary/#${id}`} aria-describedby={tipId}
  >{Astro.slots.has('default') ? <slot /> : label}<span class="air-term-tip" role="tooltip" id={tipId} aria-hidden="true">{entry.data.short}</span></a
>

<script>
  // WCAG 1.4.13: Escape dismisses the tooltip until the pointer/focus leaves.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const t = (document.activeElement as HTMLElement | null)?.closest('.air-term') ?? document.querySelector('.air-term:hover');
    t?.classList.add('air-term-dismissed');
  });
  document.querySelectorAll('.air-term').forEach((t) => {
    const reset = () => t.classList.remove('air-term-dismissed');
    t.addEventListener('mouseleave', reset);
    t.addEventListener('blur', reset);
  });
</script>

<style>
  .air-term {
    position: relative;
    color: inherit;
    text-decoration: underline dotted var(--air-brand);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
    cursor: pointer;
    border-radius: 3px;
  }
  .air-term-tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    z-index: 10;
    width: max-content;
    max-width: min(20rem, 80vw);
    padding: 12px 14px;
    border-radius: var(--air-radius);
    background: var(--air-tooltip-bg);
    color: var(--air-tooltip-fg);
    box-shadow: var(--air-shadow-lg);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    font-weight: 400;
    text-align: left;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 4px);
    transition: opacity 150ms ease, transform 150ms ease, visibility 150ms;
  }
  .air-term:not(.air-term-dismissed):hover .air-term-tip,
  .air-term:not(.air-term-dismissed):focus-visible .air-term-tip {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
</style>
