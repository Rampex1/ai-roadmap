---
import Default from '@astrojs/starlight/components/Footer.astro';
import { getEntry } from 'astro:content';
import LessonComplete from '@/components/islands/LessonComplete';
import Quiz from '@/components/islands/Quiz';
import { prepareItems } from '@/lib/quiz-data';
import { courseOf } from '@/lib/sidebar';

const { entry } = Astro.locals.starlightRoute;
const data = entry.data as { module?: string; overview?: boolean; template?: string };
const isLesson = !!data.module && !data.overview && data.template !== 'splash';
const course = courseOf(Astro.url.pathname) ?? '';
const quiz = isLesson ? await getEntry('quizzes', entry.id) : undefined;
const items = quiz ? await prepareItems(quiz.data.items) : [];
---

{items.length > 0 && <Quiz client:only="react" items={items} />}
{isLesson && <LessonComplete client:only="react" lessonId={entry.id} course={course} />}
<Default />
