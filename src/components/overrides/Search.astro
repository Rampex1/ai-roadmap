---
import Default from '@astrojs/starlight/components/Search.astro';
---

<Default {...Astro.props} />

{/* The default button's aria-label ("Search") omits its visible shortcut text, failing axe
    label-content-name-mismatch. Runs after Starlight's inline script has set Ctrl/⌘. */}
<script is:inline>
  (() => {
    const btn = document.querySelector('button[data-open-modal]');
    const keys = [...(btn?.querySelectorAll(':scope > kbd > kbd') ?? [])].map((k) => k.textContent).join(' ');
    if (btn && keys) btn.setAttribute('aria-label', `${btn.getAttribute('aria-label')} ${keys}`);
    // Pagefind renders its query field as type="text"; expose it as a searchbox once it mounts.
    const host = document.querySelector('site-search');
    if (!host) return;
    const mark = () => {
      const input = host.querySelector('.pagefind-ui__search-input');
      if (input) input.setAttribute('role', 'searchbox');
      return !!input;
    };
    if (!mark()) {
      const mo = new MutationObserver(() => mark() && mo.disconnect());
      mo.observe(host, { childList: true, subtree: true });
    }
  })();
</script>
