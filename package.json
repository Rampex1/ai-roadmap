{
  "name": "ai-roadmap",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/vendor-pyodide.mjs",
    "start": "node scripts/start.mjs",
    "serve": "node scripts/start.mjs --serve",
    "dev": "astro dev --port 4321",
    "build": "node scripts/vendor-pyodide.mjs --if-missing && astro build",
    "check": "npm run check:mdx && npm run build && npm run check:content && npm run check:exercises && npm run check:notebooks && npm run check:links && npm run check:coverage",
    "check:content": "node scripts/check-content.mjs",
    "check:exercises": "node scripts/check-exercises.mjs",
    "vendor:pyodide": "node scripts/vendor-pyodide.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:notebooks": "node scripts/check-notebooks.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:mdx": "node scripts/check-mdx.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/react": "7.1.9",
    "@astrojs/starlight": "0.43.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "astro": "7.4.13",
    "katex": "0.19.1",
    "pyodide": "314.0.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "ts-fsrs": "6.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "1.65.1",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
