{
  "name": "ai-roadmap",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "serve": "node scripts/start.mjs --serve",
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "check": "npm run build && npm run check:content",
    "check:content": "node scripts/check-content.mjs",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/react": "7.1.9",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.13",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "ts-fsrs": "6.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
